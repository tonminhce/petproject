    "nosec",
    "golangci",
    "ktlint",
    "noqa"
  ],
  "sourcemap_markers": [
    "sourceurl",
    "sourcemappingurl",
    "source-map"
  ],
  "exempt_paths": [],
  "exempt_suffixes": [],
  "generated_path_markers": [
    "/target/",
    "/node_modules/",
    "/.git/",
