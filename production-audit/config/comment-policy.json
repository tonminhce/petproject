  ],
  "tooling_markers": [
    "checkstyle",
    "spotless",
    "eslint",
    "prettier-ignore",
    "noinspection",
    "nosonar",
    "non-nls",
    "fmt: off",
    "fmt: on",
    "gofmt",
    "istanbul ignore",
