  "cards": [
    {
      "dot": "cyan",
      "title": "1. Ingress & Edge Security Gateway",
      "items": [
        "Spring Cloud Gateway định tuyến toàn bộ /api/v1/* không cắt tiền tố",
        "Keycloak 26 OIDC Reactive JwtDecoder kiểm thực JWT không cần gọi DB",
        "Redis Lua Token Bucket giới hạn 2000 req/s cụm và 100 req/s IP/user"
      ]
    },
    {
      "dot": "emerald",
      "title": "2. SAGA Orchestration & 2-Phase Kho",
      "items": [
        "OrderCreateSaga bóc tách DB transaction khỏi remote HTTP network calls",
        "Two-Phase Stock Reservation với PESSIMISTIC_WRITE và TTL 15 phút",
        "Tự động kích hoạt đền bù (Compensations) khi hết hàng hoặc tính giá fail"
      ]
    },
    {
      "dot": "violet",
      "title": "3. Event-Driven Backbone & Outbox",
      "items": [
        "Transactional Outbox loại trừ triệt để lỗi Dual-Write trong local ACID TX",
        "OrderOutboxRelay định kỳ dùng SELECT FOR UPDATE SKIP LOCKED chống đụng độ",
        "Kafka KRaft cluster bảo toàn thứ tự FIFO theo partition key (aggregateId)"
      ]
    },
    {
      "dot": "amber",
      "title": "4. Data Isolation & Caching Strategy",
      "items": [
        "Nguyên tắc Database-per-Service: 12 PostgreSQL độc lập hoàn toàn",
        "Redis Cache-Aside cho Product Catalog tăng throughput đọc gấp 10 lần",
        "Elasticsearch 8.15 đánh chỉ mục BM25 được đồng bộ gần thời gian thực"
      ]
    }
  ]
}