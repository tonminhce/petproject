  "cards": [
    {
      "dot": "emerald",
      "title": "Dual-Write Elimination",
      "items": [
        "Bản ghi nghiệp vụ và bản ghi outbox_events được commit trong cùng 1 Transaction",
        "Nếu lỗi xảy ra: cả hai cùng rollback, không bao giờ sinh ra sự kiện ma",
        "Trạng thái ban đầu luôn là PENDING với đầy đủ metadata sự kiện"
      ]
    },
    {
      "dot": "cyan",
      "title": "Row-Locking & Dispatch",
      "items": [
        "Outbox Relay dùng SELECT FOR UPDATE SKIP LOCKED để nhiều instance không đụng độ",
        "Head-of-line break dừng batch khi lỗi để giữ nguyên thứ tự sự kiện theo aggregate",
        "Sau khi Kafka ACK, trạng thái được cập nhật sang SENT kèm timestamp sent_at"
      ]
    },
    {
      "dot": "rose",
      "title": "Idempotency & Dead Letter Queue",
      "items": [
        "Consumer đảm bảo tính lũy thoái (Idempotent) qua khóa nghiệp vụ",
        "Tự động thử lại với Exponential Backoff khi gặp lỗi tạm thời",
        "Chuyển tiếp sang Dead-Letter Queue (.DLT) sau 3 lần thất bại để bảo vệ hệ thống"
      ]
    }
  ]
}
