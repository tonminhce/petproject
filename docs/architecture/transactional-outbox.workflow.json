        "id": "atomic-write",
        "label": "Atomic Dual-Write Protection",
        "focus": ["service_tx", "entity_save", "outbox_save"],
        "note": "Domain entity and outbox event commit in the exact same ACID database transaction."
      },
      {
        "id": "relay-dispatch",
        "label": "Relay Polling & Kafka Publish",
        "focus": ["outbox_save", "relay_poll", "kafka_pub"],
        "note": "Pessimistic write lock with SKIP LOCKED guarantees no duplicate publishing across instances."
      },
      {
        "id": "consume-and-dlq",
        "label": "Idempotent Consumption & DLQ",
        "focus": ["kafka_pub", "consumer_exec", "dlq_trap"],
        "note": "At-least-once delivery handled with idempotent checks and poison pill routing to DLQ."
      }
    ]
  },
  "lanes": [
