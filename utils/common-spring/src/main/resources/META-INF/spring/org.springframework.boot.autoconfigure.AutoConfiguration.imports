# =============================================================================
#  Auto-configurations owned by `common-spring` only.
# -----------------------------------------------------------------------------
#  Per-module autoconfigs (logging, security, keycloak, storage, kafka) are
#  registered by their own META-INF/...imports file under each module — NOT
#  re-exported here. Re-exporting them here caused `AutoConfigurationSorter`
#  to load class metadata for autoconfigs whose parent modules were declared
#  `<optional>true</optional>` in `common-spring/pom.xml`, raising
#  `FileNotFoundException` for services that pulled `common-spring` without
#  pulling those optional modules (see commit history).
# =============================================================================
com.shop.common.spring.autoconfigure.I18nAutoConfiguration
com.shop.common.spring.autoconfigure.WebAutoConfiguration
com.shop.common.spring.autoconfigure.ModelMapperAutoConfiguration
com.shop.common.spring.autoconfigure.JpaAuditingAutoConfiguration
