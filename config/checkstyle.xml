<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Checkstyle Configuration for PetProject Fleet Quality Gate.
  Citations:
    - https://checkstyle.org/releasenotes.html (JDK 25 support)
    - https://checkstyle.org/getting-started.html (maven-checkstyle-plugin 3.6.0)
    - docs/PATTERNS.md (Fleet patterns reference: R1, R3, R4)
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Hygiene: disallow tab characters -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- Hygiene: line length max 140 chars -->
    <module name="LineLength">
        <property name="max" value="140"/>
        <property name="ignorePattern" value="^package .*;|^import .*;|https?://"/>
    </module>

    <!-- R1: no @Builder on records (multi-line record declaration or annotation) -->
    <module name="RegexpMultiline">
        <property name="format" value="@(?:lombok\.)?Builder\s+(?:@\w+(?:\([^)]*\))?\s+)*(?:public\s+|final\s+)*record\s+\w+"/>
        <property name="message" value="R1: DTOs are records — no @Builder allowed on records (see docs/PATTERNS.md#r1)"/>
    </module>
    <module name="RegexpMultiline">
        <property name="format" value="record\s+\w+[^{]*\{[^}]*@(?:lombok\.)?Builder"/>
        <property name="message" value="R1: DTOs are records — no @Builder allowed inside records (see docs/PATTERNS.md#r1)"/>
    </module>

    <!-- Suppression filter for legacy technical debt -->
    <module name="SuppressionFilter">
        <property name="file" value="${checkstyle.suppressions.file}" default="config/checkstyle-suppressions.xml"/>
        <property name="optional" value="false"/>
    </module>

    <module name="TreeWalker">
        <!-- Imports hygiene -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="ImportOrder">
            <property name="ordered" value="false"/>
            <property name="separated" value="false"/>
            <property name="sortStaticImportsAlphabetically" value="true"/>
        </module>

        <!-- Method and parameter bounds -->
        <module name="MethodLength">
            <property name="max" value="150"/>
        </module>
        <module name="ParameterNumber">
            <property name="max" value="8"/>
            <property name="ignoreOverriddenMethods" value="true"/>
        </module>

        <!-- R3: Kafka keys must not be prefixed with properties. -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="put\(\s*&quot;properties\."/>
            <property name="message" value="R3: Kafka producer key must be plain (e.g. max.in.flight.requests.per.connection), not prefixed with properties. (see docs/PATTERNS.md#r3)"/>
        </module>

        <!-- R4: Kafka consumer trusted packages must not be wildcarded -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="addTrustedPackages\s*\(\s*&quot;\*&quot;\s*\)|TrustedPackages\.ALL|setTrustedPackages\s*\(\s*&quot;\*&quot;\s*\)"/>
            <property name="message" value="R4: Never use TrustedPackages.ALL or &quot;*&quot; — list packages explicitly (see docs/PATTERNS.md#r4)"/>
        </module>
    </module>
</module>
