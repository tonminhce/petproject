{
  "realm": "ecommerce",
  "enabled": true,
  "displayName": "Ecommerce Realm",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administrator role"
      },
      {
        "name": "USER",
        "description": "Default user role"
      },
      {
        "name": "MANAGER",
        "description": "Manager role"
      },
      {
        "name": "SERVICE",
        "description": "Machine-to-machine role for internal service calls (e.g. inventory reserve/commit/release)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ecommerce-client",
      "name": "Ecommerce Public Client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:*",
        "http://127.0.0.1:*",
        "http://api.ecommerce.local/*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:*##http://127.0.0.1:*##http://ecommerce.local/*##http://admin.ecommerce.local/*"
      }
    },
    {
      "clientId": "order-service",
      "name": "Order Service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": true,
      "secret": "${ORDER_SERVICE_CLIENT_SECRET}"
    },
    {
      "clientId": "rating-service",
      "name": "Rating Service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": true,
      "secret": "${RATING_SERVICE_CLIENT_SECRET}"
    },
    {
      "clientId": "search-service",
      "name": "Search Service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": true,
      "secret": "${SEARCH_SERVICE_CLIENT_SECRET}"
    },
    {
      "clientId": "product-service",
      "name": "Product Service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": true,
      "secret": "${PRODUCT_SERVICE_CLIENT_SECRET}"
    },
    {
      "clientId": "media-service",
      "name": "Media Service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": true,
      "secret": "${MEDIA_SERVICE_CLIENT_SECRET}"
    }
  ],
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "email": "testuser@local.dev",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER"
      ]
    },
    {
      "username": "adminuser",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "email": "adminuser@local.dev",
      "credentials": [
        {
          "type": "password",
          "value": "adminpass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN",
        "MANAGER"
      ]
    },
    {
      "username": "service-account-order-service",
      "enabled": true,
      "serviceAccountClientId": "order-service",
      "realmRoles": [
        "SERVICE"
      ]
    },
    {
      "username": "service-account-rating-service",
      "enabled": true,
      "serviceAccountClientId": "rating-service",
      "realmRoles": [
        "SERVICE"
      ]
    },
    {
      "username": "service-account-search-service",
      "enabled": true,
      "serviceAccountClientId": "search-service",
      "realmRoles": [
        "SERVICE"
      ]
    },
    {
      "username": "service-account-product-service",
      "enabled": true,
      "serviceAccountClientId": "product-service",
      "realmRoles": [
        "SERVICE"
      ]
    },
    {
      "username": "service-account-media-service",
      "enabled": true,
      "serviceAccountClientId": "media-service",
      "realmRoles": [
        "SERVICE"
      ]
    }
  ]
}
