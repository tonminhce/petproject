# ============================================================
# Environment variables template (local dev compose)
# ============================================================
# Copy this file to .env and boot directly — every value below is a working
# local default that matches docker-compose.yml's service hostnames:
#
#   cp .env.example .env
#   docker compose up -d
#
# Values marked `CHANGE IN PROD` are bootstrap/dev credentials only — rotate
# them via the production runbook (docs/PRODUCTION-READINESS.md §4.1) and set
# real values in .env.prod (template: .env.prod.example).
# DO NOT commit .env to git (it is gitignored).
# ============================================================

# ============================================================
# PostgreSQL (hosts Keycloak + all 12 service databases)
# ============================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin          # CHANGE IN PROD

# ============================================================
# Redis
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=admin             # CHANGE IN PROD

# ============================================================
# Gateway rate limiting
# ============================================================
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_REPLENISH_RATE=100
GATEWAY_RATE_LIMIT_BURST_CAPACITY=200
GATEWAY_RATE_LIMIT_REQUESTED_TOKENS=1
GATEWAY_RATE_LIMIT_TRUSTED_PROXY_HOPS=0
GATEWAY_GLOBAL_RATE_LIMIT_ENABLED=true
GATEWAY_GLOBAL_RATE_LIMIT_REPLENISH_RATE=2000
GATEWAY_GLOBAL_RATE_LIMIT_BURST_CAPACITY=4000
GATEWAY_GLOBAL_RATE_LIMIT_REQUESTED_TOKENS=1

# ============================================================
# Kafka (in-network broker hostname — local JVM runs would use localhost:9092)
# ============================================================
SHOP_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ============================================================
# Keycloak
# ============================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin    # CHANGE IN PROD (rotation runbook §4.1)
KEYCLOAK_SERVER_URL=http://keycloak:8080
# Public (browser-facing) URL — services embed it in SSO redirects
KEYCLOAK_PUBLIC_SERVER_URL=http://localhost:9090
KEYCLOAK_REALM=ecommerce
# Frontend public client from the realm import (direct-access grants enabled)
KEYCLOAK_CLIENT_ID=ecommerce-client
# Public client → no secret in dev (confidential service clients use their own
# *_SERVICE_CLIENT_SECRET rows below)
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=admin
# Issuer + JWKS source for gateway/service JWT validation (internal hostname,
# matching the x-jwt anchor in docker-compose.yml)
JWT_ISSUER_URI=http://keycloak:8080/realms/ecommerce

# ============================================================
# Object Storage (RustFS - S3 compatible)
# ============================================================
STORAGE_ENDPOINT=http://rustfs:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=admin         # CHANGE IN PROD
STORAGE_SECRET_KEY=admin         # CHANGE IN PROD
# Private media bucket (spec D1). Payment uses its own dedicated bucket.
STORAGE_BUCKET=media

# ============================================================
# Elasticsearch (xpack security disabled in dev — no real credentials)
# ============================================================
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ============================================================
# Search service (product catalog client for reindex)
# ============================================================
PRODUCT_SERVICE_URL=http://product-service:8086
SEARCH_SERVICE_CLIENT_ID=search-service
SEARCH_SERVICE_CLIENT_SECRET=changeme   # CHANGE IN PROD (rotation runbook §4.1)

# ============================================================
# Media service (RustFS storage, presigned reads — spec §4.3)
# ============================================================
MEDIA_MAX_UPLOAD=10MB
MEDIA_PRESIGN_TTL=7d
MEDIA_PURGE_GRACE=30d
# H-4 purge reference gate — client_credentials for media's
# product-reference client (confidential client in the realm import)
MEDIA_SERVICE_CLIENT_ID=media-service
MEDIA_SERVICE_CLIENT_SECRET=changeme    # CHANGE IN PROD (rotation runbook §4.1)

# ============================================================
# Product service (media existence-check client — media epic D5)
# ============================================================
MEDIA_SERVICE_URL=http://media-service:8083
PRODUCT_SERVICE_CLIENT_ID=product-service
PRODUCT_SERVICE_CLIENT_SECRET=changeme  # CHANGE IN PROD (rotation runbook §4.1)

# ============================================================
# Mail (Gmail App Password) — SMTP_ENABLED=false by default, so notification
# boots and logs instead of sending; set both to real values only when
# enabling SMTP
# ============================================================
MAIL_USERNAME=dev@example.com
MAIL_PASSWORD=changeme           # CHANGE IN PROD

# ============================================================
# App version (used in OpenAPI / Swagger UI)
# ============================================================
APP_VERSION=1.0.0

# ============================================================
# CORS (common-spring CorsAutoConfigurer)
# ============================================================
ECOMMERCE_CORS_ENABLED=true
CORS_ALLOWED_ORIGIN_PATTERNS=*

# ============================================================
# i18n (common-spring I18nAutoConfiguration)
# ============================================================
I18N_DEFAULT_LOCALE=vi

# ============================================================
# Web cross-cutters (common-spring WebAutoConfiguration)
# ============================================================
WEB_CORRELATION_ENABLED=true
WEB_EXCEPTION_HANDLER_ENABLED=true

# ============================================================
# HTTP logging (common-spring HttpLoggingFilter + LoggerAspect)
# ============================================================
WEB_LOG_REQUEST_ENABLED=false
WEB_LOG_RESPONSE_ENABLED=false
PERF_LOG_ENABLED=true
PERF_LOG_THRESHOLD_MS=50

# ------------------------------------------------------------------
# NOTE — sections removed by the fleet-hardening env sweep (T6):
#  * REST_CLIENT_* / "RestClientAutoConfiguration": that auto-configuration
#    does not exist (R1); outbound traceparent injection is applied to every
#    RestClient.Builder by the common-spring tracing BeanPostProcessor.
#  * ECOMMERCE_SECURITY_* / HTTP_LOG_*: no code binds those env names —
#    the underlying knobs live in common-spring's application.yml
#    (shop.security.*, shop.web.logging.*) and are not env-overridable.
# ------------------------------------------------------------------
