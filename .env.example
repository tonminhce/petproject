# ============================================================
# Environment variables template
# ============================================================
# Copy this file to .env and replace placeholders with real values.
# DO NOT commit .env to git (it is gitignored).
# ============================================================

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_HOST=<your-value>
POSTGRES_PORT=<your-value>
POSTGRES_DB=<your-value>
POSTGRES_USER=<your-value>
POSTGRES_PASSWORD=<your-value>

# ============================================================
# Redis
# ============================================================
REDIS_HOST=<your-value>
REDIS_PORT=<your-value>
REDIS_PASSWORD=<your-value>

# ============================================================
# Gateway rate limiting
# ============================================================
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_REPLENISH_RATE=100
GATEWAY_RATE_LIMIT_BURST_CAPACITY=200
GATEWAY_RATE_LIMIT_REQUESTED_TOKENS=1
GATEWAY_RATE_LIMIT_TRUSTED_PROXY_HOPS=0
GATEWAY_GLOBAL_RATE_LIMIT_ENABLED=true
GATEWAY_GLOBAL_RATE_LIMIT_REPLENISH_RATE=2000
GATEWAY_GLOBAL_RATE_LIMIT_BURST_CAPACITY=4000
GATEWAY_GLOBAL_RATE_LIMIT_REQUESTED_TOKENS=1

# ============================================================
# Kafka
# ============================================================
SHOP_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ============================================================
# Keycloak
# ============================================================
KEYCLOAK_ADMIN=<your-value>
KEYCLOAK_ADMIN_PASSWORD=<your-value>
KEYCLOAK_SERVER_URL=<your-value>
KEYCLOAK_PUBLIC_SERVER_URL=<your-value>
KEYCLOAK_REALM=<your-value>
KEYCLOAK_CLIENT_ID=<your-value>
KEYCLOAK_CLIENT_SECRET=<your-value>
KEYCLOAK_ADMIN_REALM=<your-value>
KEYCLOAK_ADMIN_CLIENT_ID=<your-value>
KEYCLOAK_ADMIN_USERNAME=<your-value>
JWT_ISSUER_URI=<your-value>
KEYCLOAK_JWK_SET_URI=<your-value>

# ============================================================
# Object Storage (RustFS - S3 compatible)
# ============================================================
STORAGE_ENDPOINT=<your-value>
STORAGE_REGION=<your-value>
STORAGE_ACCESS_KEY=<your-value>
STORAGE_SECRET_KEY=<your-value>
# Private media bucket (spec D1). Payment uses its own dedicated bucket.
STORAGE_BUCKET=media

# ============================================================
# Elasticsearch
# ============================================================
ELASTICSEARCH_URL=<your-value>
ELASTICSEARCH_USERNAME=<your-value>
ELASTICSEARCH_PASSWORD=<your-value>

# ============================================================
# Search service (product catalog client for reindex)
# ============================================================
PRODUCT_SERVICE_URL=http://product-service:8086
SEARCH_SERVICE_CLIENT_ID=search-service
SEARCH_SERVICE_CLIENT_SECRET=changeme

# ============================================================
# Media service (RustFS storage, presigned reads — spec §4.3)
# ============================================================
MEDIA_MAX_UPLOAD=10MB
MEDIA_PRESIGN_TTL=7d
MEDIA_PURGE_GRACE=30d

# ============================================================
# Product service (media existence-check client — media epic D5)
# ============================================================
MEDIA_SERVICE_URL=http://media-service:8083
PRODUCT_SERVICE_CLIENT_ID=product-service
PRODUCT_SERVICE_CLIENT_SECRET=changeme

# ============================================================
# Mail (Gmail App Password)
# ============================================================
MAIL_USERNAME=<your-value>
MAIL_PASSWORD=<your-value>

# ============================================================
# App version (used in OpenAPI / Swagger UI)
# ============================================================
APP_VERSION=<your-value>

# ============================================================
# Security (common-spring BaseSecurityConfig)
# ============================================================
ECOMMERCE_SECURITY_ENABLED=<your-value>
ECOMMERCE_SECURITY_CSRF_DISABLED=<your-value>
ECOMMERCE_SECURITY_STATELESS_SESSION=<your-value>

# ============================================================
# CORS (common-spring CorsAutoConfigurer)
# ============================================================
ECOMMERCE_CORS_ENABLED=<your-value>
CORS_ALLOWED_ORIGIN_PATTERNS=<your-value>
CORS_ALLOW_CREDENTIALS=<your-value>
CORS_MAX_AGE_SECONDS=<your-value>

# ============================================================
# RestClient connection pool (common-spring RestClientAutoConfiguration)
# ============================================================
REST_CLIENT_CONNECT_TIMEOUT=<your-value>
REST_CLIENT_READ_TIMEOUT=<your-value>
REST_CLIENT_POOL_MAX_TOTAL=<your-value>
REST_CLIENT_POOL_MAX_PER_ROUTE=<your-value>
REST_CLIENT_POOL_KEEP_ALIVE=<your-value>
REST_CLIENT_POOL_EVICT_IDLE_AFTER=<your-value>

# ============================================================
# i18n (common-spring I18nAutoConfiguration)
# ============================================================
I18N_DEFAULT_LOCALE=<your-value>
I18N_CACHE_DURATION=<your-value>

# ============================================================
# Web cross-cutters (common-spring WebAutoConfiguration)
# ============================================================
WEB_CORRELATION_ENABLED=<your-value>
WEB_EXCEPTION_HANDLER_ENABLED=<your-value>

# ============================================================
# HTTP Logging (HttpLoggingFilter + LoggerAspect)
# ============================================================
HTTP_LOG_REQUEST_ENABLED=<your-value>
HTTP_LOG_REQUEST_BODY=<your-value>
HTTP_LOG_REQUEST_MAX_BYTES=<your-value>
HTTP_LOG_RESPONSE_ENABLED=<your-value>
HTTP_LOG_RESPONSE_BODY=<your-value>
HTTP_LOG_RESPONSE_MAX_BYTES=<your-value>
HTTP_LOG_PERF_ENABLED=<your-value>
HTTP_LOG_PERF_THRESHOLD_MS=<your-value>
