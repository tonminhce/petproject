# ============================================================
# Environment variables template (local dev compose)
# ============================================================
# Copy this file to .env, fill in the blank values, then boot:
#
#   cp .env.example .env
#   docker compose up -d
#
# NO credential ships in this repository. Every password, secret, access key
# and privileged account name below is EMPTY on purpose, and docker-compose.yml
# refuses to render the stack while one of them is blank - the operator has to
# supply a value before the first `docker compose up`. The compose error names
# the variable that is still missing.
#
# Step 1 - generate a random value for every blank credential:
#
#   awk 'BEGIN{srand()} /^([A-Z0-9_]*(PASSWORD|SECRET|ACCESS_KEY)|KEYCLOAK_ADMIN|ES_ADMIN_USERNAME)=$/ && !/^KEYCLOAK_CLIENT_SECRET=$/ && !/^TELEGRAM_BOT_TOKEN=$/ {printf "%s", $1; for (i = 0; i < 32; i++) printf "%02x", int(rand()*256); printf "\n"; next} {print}' .env.example > .env
#
# Step 2 - set the values no generator can invent: the Telegram bot token and
# the chat ids (the token is issued by @BotFather, the chat id by the chat):
#
#   TELEGRAM_BOT_TOKEN=<token from @BotFather>
#   TELEGRAM_CHAT_ID=<chat id>
#
# Step 3 - rotate every value per deployment and never reuse one value for
# two accounts. The production template (.env.prod.example) carries the same
# variables with the rotation runbook (docs/PRODUCTION-READINESS.md 4.1).
# DO NOT commit .env to git (it is gitignored).
# ============================================================

# ============================================================
# PostgreSQL (hosts Keycloak + all 12 service databases)
# ============================================================
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_USER=admin
POSTGRES_PASSWORD=

# ============================================================
# Redis
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================
# Gateway rate limiting
# ============================================================
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_REPLENISH_RATE=100
GATEWAY_RATE_LIMIT_BURST_CAPACITY=200
GATEWAY_RATE_LIMIT_REQUESTED_TOKENS=1
GATEWAY_RATE_LIMIT_OUTAGE_POLICY=FAIL_CLOSED
GATEWAY_TRUSTED_PROXY_CIDRS=
GATEWAY_TRUSTED_PROXY_HOPS=0
GATEWAY_GLOBAL_RATE_LIMIT_ENABLED=true
GATEWAY_GLOBAL_RATE_LIMIT_REPLENISH_RATE=2000
GATEWAY_GLOBAL_RATE_LIMIT_BURST_CAPACITY=4000
GATEWAY_GLOBAL_RATE_LIMIT_REQUESTED_TOKENS=1

# ============================================================
# Kafka (in-network broker hostname — local JVM runs would use localhost:9092)
# ============================================================
SHOP_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ============================================================
# Keycloak
# ============================================================
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

# Grafana (observability profile) — dashboard access
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
KEYCLOAK_SERVER_URL=http://keycloak:8080
# Public (browser-facing) URL — services embed it in SSO redirects
KEYCLOAK_PUBLIC_SERVER_URL=http://localhost:9090
KEYCLOAK_REALM=ecommerce
# Frontend public client from the realm import (direct-access grants enabled)
KEYCLOAK_CLIENT_ID=ecommerce-client
# Public client → no secret in dev (confidential service clients use their own
# *_SERVICE_CLIENT_SECRET rows below)
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_REALM=master
# F-078: the admin path uses the service account of the ecommerce realm
# (client_credentials). The master-realm admin credential is NOT used by the
# services any more - it stays only as the bootstrap credential of the
# Keycloak container.
KEYCLOAK_ADMIN_CLIENT_ID=
# KEYCLOAK_SERVICE_ACCOUNT_CLIENT_ID=ecommerce-admin
KEYCLOAK_ADMIN_USERNAME=
ADMIN_SERVICE_CLIENT_SECRET=
# Issuer + JWKS source for gateway/service JWT validation (internal hostname,
# matching the x-jwt anchor in docker-compose.yml)
JWT_ISSUER_URI=http://keycloak:8080/realms/ecommerce

# ============================================================
# Object Storage (RustFS - S3 compatible)
# ============================================================
STORAGE_ENDPOINT=http://rustfs:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Private media bucket (spec D1). Payment uses its own dedicated bucket.
STORAGE_BUCKET=media

# ============================================================
# Elasticsearch (H34 — xpack security ENABLED in dev, BASIC auth over HTTP)
# ============================================================
# H34 — xpack.security.enabled=true in docker-compose.yml. The application
# client (search-service) authenticates as this admin user; the same password
# bootstraps the built-in `elastic` superuser so the node actually boots under
# security (ES 8.x refuses to start without it). Production overlay MUST
# flip xpack.security.http.ssl.enabled=true (real cert) and rotate these
# values via .env.prod — see docs/PRODUCTION-READINESS.md §4.x.
ELASTICSEARCH_URL=http://elasticsearch:9200
# Username/password of the search-service ES admin user. The built-in
# `elastic` superuser is a footgun in any non-local deployment - create a
# dedicated service user with the minimum required privileges and rotate both
# values per deployment. Leave ES_ADMIN_USERNAME=elastic for a local single
# node only; the compose file then uses the built-in superuser.
ES_ADMIN_USERNAME=
ES_ADMIN_PASSWORD=

# ============================================================
# Search service (product catalog client for reindex)
# ============================================================
PRODUCT_SERVICE_URL=http://product-service:8086
SEARCH_SERVICE_CLIENT_ID=search-service
SEARCH_SERVICE_CLIENT_SECRET=

# ============================================================
# Media service (RustFS storage, presigned reads — spec §4.3)
# ============================================================
# F-054: the password reset email is dispatched over SMTP. Without a channel
# the reset request fails (503 AUTH-1010) instead of reporting a false success.
# F-060: the inventory-service base URL used by the delete-time stock guard
INVENTORY_SERVICE_URL=http://inventory-service:8082

AUTH_MAIL_ENABLED=false
AUTH_MAIL_FROM=
AUTH_RESET_BASE_URL=http://localhost:3000/reset-password

MEDIA_MAX_UPLOAD=10MB
# F-062: budget for the DECODED image (width x height x 4 bytes) plus the source
# bytes - a bigger image is rejected with 413 before it is decoded
MEDIA_MAX_DECODED_BYTES=64MB
MEDIA_PRESIGN_TTL=7d
MEDIA_PURGE_GRACE=30d
# H-4 purge reference gate — client_credentials for media's
# product-reference client (confidential client in the realm import)
MEDIA_SERVICE_CLIENT_ID=media-service
MEDIA_SERVICE_CLIENT_SECRET=

# ============================================================
# Product service (media existence-check client — media epic D5)
# ============================================================
MEDIA_SERVICE_URL=http://media-service:8083
PRODUCT_SERVICE_CLIENT_ID=product-service
PRODUCT_SERVICE_CLIENT_SECRET=

# ============================================================
# Mail (Gmail App Password) — SMTP_ENABLED=false by default, so notification
# boots and logs instead of sending; set both to real values only when
# enabling SMTP
# ============================================================
MAIL_USERNAME=dev@example.com
MAIL_PASSWORD=
# H22 — REQUIRED when SMTP_ENABLED=true. SmtpNotificationSender fails fast
# on null/blank; there is no default so a misconfigured deploy never silently
# routes to a hardcoded recipient. Set this to the ops alias that should
# receive the notification (or a per-env mailbox) before flipping SMTP on.
SHOP_NOTIFICATION_SMTP_FALLBACK_RECIPIENT=

# ============================================================
# Payment (C5 — mock provider is the default; Stripe is opt-in)
# ============================================================
# HMAC secret for carrier webhooks (required by compose — the mock provider
# verifies webhook signatures with it too)
PAYMENT_WEBHOOK_SECRET=
# To activate Stripe (TEST mode first): set SHOP_PAYMENT_PROVIDER=stripe and
# uncomment BOTH key lines with real values from ops — placeholders below must
# NEVER be committed with real keys.
# The compose stack REFUSES to start the payment service when the Stripe key is
# a live-mode key (sk_live_...) unless SHOP_PAYMENT_ALLOW_LIVE_STRIPE_KEYS=true
# is set explicitly — a test or load environment must never set that flag.
# SHOP_PAYMENT_PROVIDER=mock
# SHOP_PAYMENT_STRIPE_SECRET_KEY=sk_test_xxx    # CHANGE IN PROD (ops-provisioned)
# SHOP_PAYMENT_STRIPE_API_BASE=                 # blank = the Stripe production endpoint
# The Stripe webhook signing secret. The compose stack requires it because the
# default provider is stripe - set the value the Stripe dashboard shows for the
# webhook endpoint when the account is a real one.
SHOP_PAYMENT_STRIPE_WEBHOOK_SECRET=
#
# MoMo sandbox (https://developers.momo.vn) — SHOP_PAYMENT_PROVIDER=momo
# The provider stays unregistered until every key below is set and the enable
# flag is on. The notify url is the server-to-server callback and the return
# url is the browser redirect the customer lands on after paying.
# SHOP_PAYMENT_MOMO_ENABLED=false
# SHOP_PAYMENT_MOMO_BASE_URL=https://test-payment.momo.vn
# SHOP_PAYMENT_MOMO_PARTNER_CODE=xxx
# SHOP_PAYMENT_MOMO_ACCESS_KEY=xxx
# SHOP_PAYMENT_MOMO_SECRET_KEY=xxx
# SHOP_PAYMENT_MOMO_RETURN_URL=https://<frontend>/payment/momo/return
# SHOP_PAYMENT_MOMO_NOTIFY_URL=https://<host>/api/v1/webhooks/payments/momo/ipn
#
# VNPay sandbox (https://sandbox.vnpayment.vn/apis) — SHOP_PAYMENT_PROVIDER=vnpay
# SHOP_PAYMENT_VNPAY_ENABLED=false
# SHOP_PAYMENT_VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# SHOP_PAYMENT_VNPAY_API_URL=https://sandbox.vnpayment.vn
# SHOP_PAYMENT_VNPAY_TMN_CODE=xxx
# SHOP_PAYMENT_VNPAY_HASH_SECRET=xxx
# SHOP_PAYMENT_VNPAY_RETURN_URL=https://<frontend>/payment/vnpay/return
# SHOP_PAYMENT_VNPAY_NOTIFY_URL=https://<host>/api/v1/webhooks/payments/vnpay/ipn
#
# Production mode rejects a simulated provider or an unconfigured integration at
# startup. Enable it wherever the deployment is a real environment.
# SHOP_PAYMENT_PRODUCTION_MODE=false

# ============================================================
# App version (used in OpenAPI / Swagger UI)
# ============================================================
APP_VERSION=1.0.0

# ============================================================
# CORS (common-spring CorsAutoConfigurer)
# ============================================================
ECOMMERCE_CORS_ENABLED=true
# F-006: never a wildcard origin - list the real front-end origins
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://localhost:5173

# ============================================================
# i18n (common-spring I18nAutoConfiguration)
# ============================================================
I18N_DEFAULT_LOCALE=vi

# ============================================================
# Web cross-cutters (common-spring WebAutoConfiguration)
# ============================================================
WEB_CORRELATION_ENABLED=true
WEB_EXCEPTION_HANDLER_ENABLED=true

# ============================================================
# HTTP logging (common-spring HttpLoggingFilter + LoggerAspect)
# ============================================================
WEB_LOG_REQUEST_ENABLED=false
WEB_LOG_RESPONSE_ENABLED=false
PERF_LOG_ENABLED=true
PERF_LOG_THRESHOLD_MS=50

# ============================================================
# HTTP Logging (HttpLoggingFilter + LoggerAspect)
# ============================================================
# H35 — both *_BODY flags default to FALSE in baseline dev + prod. The
# request body can carry passwords, PII, payment credentials and auth
# header payload (refresh tokens, …); logging it at INFO leaks secrets
# to log aggregators and any operator with log read access. The flag
# stays ON-able per env only when an explicit scrubbing/redaction layer
# is in place. The 2 KiB cap on the request body (HTTP_LOG_REQUEST_MAX_BYTES)
# stays as defence-in-depth even when the flag is flipped on.
#
# NOTE — these HTTP_LOG_* env names are not directly bound to a Spring
# property (the underlying knob is shop.web.logging.request.include-body
# in common-spring's application.yml). They are kept here as
# documentation of the secure default; services that want to override
# must set shop.web.logging.request.include-body in their own
# application.yml, NOT just this env file.
HTTP_LOG_REQUEST_ENABLED=true
HTTP_LOG_REQUEST_BODY=false
HTTP_LOG_REQUEST_MAX_BYTES=2048
HTTP_LOG_RESPONSE_ENABLED=true
HTTP_LOG_RESPONSE_BODY=false
HTTP_LOG_RESPONSE_MAX_BYTES=2048
HTTP_LOG_PERF_ENABLED=true
HTTP_LOG_PERF_THRESHOLD_MS=50

# ------------------------------------------------------------------
# NOTE — sections removed by the fleet-hardening env sweep (T6):
#  * REST_CLIENT_* / "RestClientAutoConfiguration": that auto-configuration
#    does not exist (R1); outbound traceparent injection is applied to every
#    RestClient.Builder by the common-spring tracing BeanPostProcessor.
#  * ECOMMERCE_SECURITY_*: no code binds those env names — the underlying
#    knobs live in common-spring's application.yml (shop.security.*) and
#    are not env-overridable.
# ------------------------------------------------------------------
ORDER_SERVICE_CLIENT_SECRET=
RATING_SERVICE_CLIENT_SECRET=
# The seeded Keycloak test user. The load harness (load-tests/run.py) logs this
# user in with the password it is configured with - keep both in sync.
KEYCLOAK_TEST_USER_PASSWORD=
# F-080: the password of the seeded ADMIN realm user (adminuser). It was the
# literal "adminpass" in the realm import - an ADMIN account reachable with a
# well-known password in every deployment that did not override it. The value
# ships empty: the realm bootstrap refuses to boot while it is unset.
KEYCLOAK_ADMIN_USER_PASSWORD=
SHIPMENT_WEBHOOK_SECRET_GHN=
SHIPMENT_WEBHOOK_SECRET_GHTK=

# ============================================================
# Observability - alerting (Telegram receiver)
# ============================================================
# The bot token and the chat ids are issued by Telegram, no generator can
# invent them: set them by hand. An empty value keeps the alertmanager stack
# closed instead of delivering alerts to the wrong destination.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CI_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=true
