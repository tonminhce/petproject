# ============================================================
# Production environment variables template (compose PROD overlay)
# ============================================================
# Copy this file to .env.prod, fill real values, then run:
#
#   docker compose --env-file .env.prod \
#     -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# DO NOT commit .env.prod to git (it is gitignored).
# Runbook: docs/PRODUCTION-READINESS.md (§4.1 Deployment topology).
# The overlay strips ALL host ports except the gateway ingress; infrastructure
# is reachable only on the internal docker network.
# ============================================================

# ============================================================
# Ingress (gateway — the ONLY published port in prod)
# ============================================================
# Host port the trusted reverse proxy / LB forwards to. The proxy MUST
# OVERWRITE X-Forwarded-For before traffic reaches the gateway (§4.1).
GATEWAY_INGRESS_PORT=8080

# ============================================================
# Backoffice IP allowlist (D5) — REQUIRED in prod
# ============================================================
# Comma-separated CIDRs allowed to reach backoffice ADMIN endpoints,
# e.g. 10.0.0.0/8,192.168.1.0/24.
# ⚠ ABSENT or EMPTY STRING = filter INACTIVE (allow-all) — an empty value
# here is a MISCONFIGURATION, not a safe default. Never ship it empty.
# Invalid CIDRs fail gateway startup (fail-fast). Bypassed paths:
# /api/v1/webhooks/** and /actuator/health.
ADMIN_IP_ALLOWLIST=<operator-cidrs-comma-separated>

# ============================================================
# Gateway rate limiting (trusted-proxy posture)
# ============================================================
# Number of trusted proxies in front of the gateway. The overlay defaults to
# 1 (the mandated LB). Only change if the topology §4.1 changes.
#GATEWAY_RATE_LIMIT_TRUSTED_PROXY_HOPS=1
#GATEWAY_RATE_LIMIT_ENABLED=true
#GATEWAY_RATE_LIMIT_REPLENISH_RATE=100
#GATEWAY_RATE_LIMIT_BURST_CAPACITY=200
#GATEWAY_RATE_LIMIT_REQUESTED_TOKENS=1
#GATEWAY_GLOBAL_RATE_LIMIT_ENABLED=true
#GATEWAY_GLOBAL_RATE_LIMIT_REPLENISH_RATE=2000
#GATEWAY_GLOBAL_RATE_LIMIT_BURST_CAPACITY=4000
#GATEWAY_GLOBAL_RATE_LIMIT_REQUESTED_TOKENS=1

# ============================================================
# Secret rotation (D2) — REQUIRED in prod
# ============================================================
# Rotate via Keycloak admin API PUT (runbook §4.1), then set here. The overlay
# overrides the dev defaults ("changeme") with these values; an EMPTY value
# FAILS CLOSED — client_credentials calls are rejected by Keycloak.
ORDER_SERVICE_CLIENT_SECRET=<rotated-strong-value>
RATING_SERVICE_CLIENT_SECRET=<rotated-strong-value>
SEARCH_SERVICE_CLIENT_SECRET=<rotated-strong-value>

# ============================================================
# Keycloak (bootstrap admin — rotate before first prod start)
# ============================================================
KEYCLOAK_ADMIN=<your-value>
KEYCLOAK_ADMIN_PASSWORD=<strong-rotated-value>
KEYCLOAK_PUBLIC_SERVER_URL=<your-value>
KEYCLOAK_CLIENT_ID=<your-value>
KEYCLOAK_CLIENT_SECRET=<your-value>
KEYCLOAK_ADMIN_REALM=<your-value>
KEYCLOAK_ADMIN_CLIENT_ID=<your-value>
KEYCLOAK_ADMIN_USERNAME=<your-value>

# ============================================================
# PostgreSQL (hosts Keycloak + all 12 service databases)
# ============================================================
POSTGRES_DB=<your-value>
POSTGRES_USER=<your-value>
POSTGRES_PASSWORD=<strong-value>
# Base-compose dev knob; unused in prod (host port stripped by the overlay).
#POSTGRES_PORT=5432

# ============================================================
# Redis
# ============================================================
REDIS_PASSWORD=<strong-value>

# ============================================================
# Object Storage (RustFS - S3 compatible)
# ============================================================
STORAGE_ACCESS_KEY=<strong-value>
STORAGE_SECRET_KEY=<strong-value>
STORAGE_BUCKET=<your-value>

# ============================================================
# Elasticsearch
# ============================================================
ELASTICSEARCH_USERNAME=<your-value>
ELASTICSEARCH_PASSWORD=<strong-value>

# ============================================================
# Mail (Gmail App Password)
# ============================================================
MAIL_USERNAME=<your-value>
MAIL_PASSWORD=<your-value>

# ============================================================
# Payment
# ============================================================
#PAYMENT_SERVICE_ENABLED=false
#PAYMENT_PROVIDER=mock
#PAYMENT_WEBHOOK_SECRET=<strong-value>
#STRIPE_SECRET_KEY=

# ============================================================
# OpenTelemetry (D3) — OPTIONAL, env-gated
# ============================================================
# Uncomment to export spans to an OTLP collector. While commented (or the var
# is absent), there is NO exporter — tracing still populates MDC
# (traceId in logs + W3C traceparent propagation). An EMPTY value must not be
# wired: it would enable the exporter with a blank endpoint.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ============================================================
# Audit logging (D6) — no host var needed
# ============================================================
# The overlay writes @Audited events on the 8 audited services to
# /var/log/audit/audit.jsonl inside the named volume `audit_logs`
# (AUDIT_LOG_PATH is fixed in the overlay). Ship the file off-box with
# filebeat/vector. If AUDIT_LOG_PATH were unset, events fall back to the
# stdout AUDIT logger.

# ============================================================
# Shipping (defaults shown; uncomment to override)
# ============================================================
#SHIPMENT_AUTO_DELIVER_DAYS=7
#SHIPPING_NOTIFY_THRESHOLD_HOURS=72
#SHOP_SHIPPING_CARRIER=manual
#SHIPMENT_WEBHOOK_SECRET_GHN=

# ============================================================
# Notification SMTP (defaults shown; uncomment to override)
# ============================================================
#SMTP_ENABLED=false
#SMTP_FALLBACK_RECIPIENT=ops@example.com
